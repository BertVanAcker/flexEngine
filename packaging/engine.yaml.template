# /etc/flexengine/engine.yaml -- flexEngineV2 host config (written once by packaging/install.sh; never overwritten).
# Form of demo/edge/edge.example.yaml (the keys flexengine2.host.load_config reads today); ${VARS} are expanded from
# the environment (put them in a drop-in: Environment= / EnvironmentFile=).
# TODO(EV-08 -> config schema): re-validate with `flexengine config check --config /etc/flexengine/engine.yaml` once
# src/flexengine2/config/ ships the canonical schema (plan §3.6: apiVersion, identity, local, observability,
# safeState blocks), and move this template to that form.
cloud:
  apiUrl: https://lattepanda.lab:8700                 # flexCloud southbound API (P2)
  cloudPublicKey: ""                                  # b64 Ed25519 trust anchor for desired-state signatures
  releaseKeyFiles: []                                 # or releasePublicKeys: [<b64>] -- release signing key(s)
  pollInterval: 1.0
  backoff: [0.25, 4.0]
  httpTimeout: 5
dataDir: /var/lib/flexengine                          # per device: <dataDir>/<deviceId>/{state.json,actions.jsonl,...}
devices:
  - deviceId: @DEVICE_ID@                             # this host (install.sh: --device-id, default the hostname)
    role: standalone-device                           # gateway when MCU children are listed with parent: <this id>
    onboardingTokenFile: /etc/flexengine/tokens/@DEVICE_ID@   # one-time token from flexCloud (root:flex 0640)
    safeStateFile: /var/lib/flexengine/safe-state.json        # {"machine_parked": true, "operator_confirmed": true}
    drivers:
      container: {runtime: docker}                    # podman | docker; the flex user needs the docker group
      # plc-verify:
      #   plcs:
      #     panda/cx: {via: ads, amsNetId: <cx>, ip: <cx-ip>, amsPort: 851, localNetId: <lp>}
      #     opta: {via: modbus, host: <opta-ip>, port: 502}
  # - deviceId: @DEVICE_ID@.portenta                  # see-thru MCU child over SMP (extra [mcu])
  #   parent: @DEVICE_ID@
  #   modelDevice: portenta
  #   onboardingTokenFile: /etc/flexengine/tokens/@DEVICE_ID@.portenta
  #   mcu:
  #     smp: {host: 127.0.0.1, port: 5555}            # socat/flex-smp-bridge in alpha; tty: in a later release
  #     modulePublicKey: <hex>
