+void FlexNode::report_ota(const char* st, const char* reason) {
+  StaticJsonDocument<512> doc;
+  doc["ref"] = ota_ref_.c_str();
+  doc["state"] = st;
+  doc["version"] = ota_target_.c_str();
+  doc["running"] = flexCloud.swc_version();
+  if (reason && reason[0]) doc["reason"] = reason;
+  if (strcmp(st, "booted") == 0) doc["bootId"] = boot_id_;
+  char buffer[512];
+  serializeJson(doc, buffer, sizeof(buffer));
+  flexCloud.set_ota_state(buffer);
+}
+
+void FlexNode::ota_state_cb(const char* st, const char* reason) {
+  if (!instance || !instance->ota_ref_.length()) return;      // a sketch-triggered OTA: nothing to report
+  instance->report_ota(st, reason);
+  if (strcmp(st, "failed") == 0) instance->ota_ref_ = "";       // final: AFTER_OTA continues on this firmware
+}
+
+// the first set_application_version() after a remote update: tell the engine which firmware came up
+void FlexNode::mark_booted() {
+  String raw = flexCloud.ota_state();
+  if (!raw.length()) return;
+  StaticJsonDocument<512> doc;
+  if (deserializeJson(doc, raw)) return;
+  const char* st = doc["state"];
+  if (!st || strcmp(st, "restarting") != 0) return;
+  ota_ref_ = doc["ref"] | "";
+  ota_target_ = doc["version"] | "";
+  report_ota("booted", "");
+}
+
+void FlexNode::heartbeat() {
+  StaticJsonDocument<256> doc;
+  doc["bootId"] = boot_id_;
+  doc["uptime"] = millis() / 1000;
+  doc["version"] = flexCloud.swc_version();
+  doc["status"] = AS_toString(flexCloud.status());
+  char buffer[256];
+  serializeJson(doc, buffer, sizeof(buffer));
+  flexCloud.heartbeat(buffer, 3 * FLEXNODE_HEARTBEAT_S);
+}
