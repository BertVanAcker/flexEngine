diff -ruN a/examples/features/otaRemote/otaRemote.ino b/examples/features/otaRemote/otaRemote.ino
--- a/examples/features/otaRemote/otaRemote.ino	1970-01-01 00:00:00.000000000 +0000
+++ b/examples/features/otaRemote/otaRemote.ino
@@ -0,0 +1,35 @@
+/*
+ * Remote OTA update through flexEngineV2 (Portenta H7 / Machine Control / Opta)
+ *
+ * The sketch only reports its version: the update is started from outside. A flexEngineV2 with the arduino-ota
+ * driver serves the verified .ota image on the LAN and publishes a signed OTA_UPDATE command on
+ * flexcloud/<connectorID>/<applicationID>/cmd. The library checks the HMAC-SHA256 signature with
+ * appDescriptor_config's flexCloud secret key, downloads the image, checks its size and sha256 against the command,
+ * installs it and restarts; the progress is in the flexCloud key <connectorID>:applications:<applicationID>:ota and
+ * the node writes a heartbeat key every FLEXNODE_HEARTBEAT_S seconds.
+ *
+ * Build the image with FIRMWARE_VERSION set to the release's dev.flex.firmwareVersion:
+ *   python3 tools/hwtest/make_ota.py --sketch examples/features/otaRemote --fqbn arduino:mbed_portenta:envie_m7 \
+ *       --library . -o build/otaRemote-0.2.0.ota
+ * Requires the Portenta bootloader with OTA support and ota_config enabled.
+ */
+#include <flexNode.h>
+#include "communicationMatrix.h"
+#include "configuration.h"
+
+// version of THIS firmware (= dev.flex.firmwareVersion of its release)
+const char* FIRMWARE_VERSION = "0.1.0";
+
+auto props = getDefaultProperties();
+FlexNode node("OTA_01", "Remote OTA example", props);
+
+void setup() {
+  node.begin();
+  node.set_application_version(FIRMWARE_VERSION);   // also tells the engine which firmware came up after an update
+  node.consolelogger.info(String("firmware version ") + FIRMWARE_VERSION);
+  node.set_application_status(ApplicationStatus::RUNNING);
+}
+
+void loop() {
+  node.spin();
+}
diff -ruN a/src/commands/otaCommand.cpp b/src/commands/otaCommand.cpp
--- a/src/commands/otaCommand.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/src/commands/otaCommand.cpp
@@ -0,0 +1,140 @@
+#include "commands/otaCommand.h"
+#include <ArduinoJson.h>
+#include <time.h>
+#include <stdio.h>
+#include "mbedtls/md.h"
+
+// ids of the last commands (a command is executed once)
+static String seen_ids[8];
+static unsigned int seen_next = 0;
+
+static void to_hex(const uint8_t* in, size_t n, char* out) {
+  static const char* digits = "0123456789abcdef";
+  for (size_t i = 0; i < n; i++) {
+    out[2 * i] = digits[in[i] >> 4];
+    out[2 * i + 1] = digits[in[i] & 0x0f];
+  }
+  out[2 * n] = 0;
+}
+
+static bool hmac_sha256_hex(const uint8_t* key, size_t keylen, const String& data, char out[65]) {
+  uint8_t mac[32];
+  const mbedtls_md_info_t* info = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
+  mbedtls_md_context_t ctx;
+  mbedtls_md_init(&ctx);
+  bool ok = info && mbedtls_md_setup(&ctx, info, 1) == 0 &&
+            mbedtls_md_hmac_starts(&ctx, key, keylen) == 0 &&
+            mbedtls_md_hmac_update(&ctx, reinterpret_cast<const unsigned char*>(data.c_str()), data.length()) == 0 &&
+            mbedtls_md_hmac_finish(&ctx, mac) == 0;
+  mbedtls_md_free(&ctx);
+  if (ok) to_hex(mac, sizeof(mac), out);
+  return ok;
+}
+
+bool sha256_file_hex(const char* path, char out[65]) {
+  FILE* f = fopen(path, "rb");
+  if (!f) return false;
+  const mbedtls_md_info_t* info = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
+  mbedtls_md_context_t ctx;
+  mbedtls_md_init(&ctx);
+  bool ok = info && mbedtls_md_setup(&ctx, info, 0) == 0 && mbedtls_md_starts(&ctx) == 0;
+  static unsigned char buf[1024];
+  size_t n;
+  while (ok && (n = fread(buf, 1, sizeof(buf), f)) > 0) {
+    ok = mbedtls_md_update(&ctx, buf, n) == 0;
+  }
+  ok = ok && !ferror(f);
+  fclose(f);
+  uint8_t digest[32];
+  ok = ok && mbedtls_md_finish(&ctx, digest) == 0;
+  mbedtls_md_free(&ctx);
+  if (ok) to_hex(digest, sizeof(digest), out);
+  return ok;
+}
+
+// a string json.dumps() writes as is (printable ASCII without '"' and '\')
+static bool plain(const char* s) {
+  if (!s) return false;
+  for (; *s; s++) {
+    if (*s < 0x20 || *s > 0x7e || *s == '"' || *s == '\\') return false;
+  }
+  return true;
+}
+
+static bool is_hex64(const String& s) {
+  if (s.length() != 64) return false;
+  for (unsigned int i = 0; i < s.length(); i++) {
+    char c = s[i];
+    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
+  }
+  return true;
+}
+
+OtaCommandResult parse_ota_command(const uint8_t* payload, unsigned int length, const uint8_t* key, size_t keylen,
+                                   OtaCommand& out) {
+  DynamicJsonDocument doc(1536);
+  if (deserializeJson(doc, payload, length)) return OtaCommandResult::NOT_JSON;
+  const char* cmd = doc["cmd"];
+  if (!cmd || strcmp(cmd, "OTA_UPDATE") != 0) return OtaCommandResult::NOT_OTA;
+
+  JsonObject p = doc["params"];
+  const char* id = doc["id"];
+  const char* nonce = doc["nonce"];
+  const char* sig = doc["signature"];
+  const char* board = p["board"];
+  const char* sha = p["sha256"];
+  const char* url = p["url"];
+  const char* version = p["version"];
+  if (p.isNull() || p.size() != 5 || !p["size"].is<unsigned long>() || !doc["priority"].is<long>() ||
+      !doc["expiry"].is<unsigned long>() || !doc["timestamp"].is<unsigned long>() || !plain(id) || !plain(nonce) ||
+      !plain(sig) || !plain(board) || !plain(sha) || !plain(url) || !plain(version)) {
+    return OtaCommandResult::BAD_PARAMS;
+  }
+  unsigned long size = p["size"].as<unsigned long>();
+  long priority = doc["priority"].as<long>();
+  unsigned long expiry = doc["expiry"].as<unsigned long>();
+  unsigned long timestamp = doc["timestamp"].as<unsigned long>();
+
+  // json.dumps(params, sort_keys=True)
+  String params = String("{\"board\": \"") + board + "\", \"sha256\": \"" + sha + "\", \"size\": " + String(size) +
+                  ", \"url\": \"" + url + "\", \"version\": \"" + version + "\"}";
+  String data = String(id) + cmd + String(priority) + String(expiry) + params + String(timestamp) + nonce;
+  char expect[65];
+  if (!key || !hmac_sha256_hex(key, keylen, data, expect) || strlen(sig) != 64) {
+    return OtaCommandResult::BAD_SIGNATURE;
+  }
+  uint8_t diff = 0;                     // constant time compare
+  for (int i = 0; i < 64; i++) diff |= static_cast<uint8_t>(expect[i] ^ sig[i]);
+  if (diff) return OtaCommandResult::BAD_SIGNATURE;
+
+  for (const String& s : seen_ids) {
+    if (s == id) return OtaCommandResult::DUPLICATE;
+  }
+  seen_ids[seen_next++ % 8] = id;
+
+  out.id = id;
+  out.expiry = expiry;
+  // without a set clock (no NTP before P2) the expiry cannot be checked; the one-time URL limits a replay
+  time_t now = time(nullptr);
+  if (now > 1700000000 && static_cast<unsigned long>(now) > expiry) return OtaCommandResult::EXPIRED;
+  out.board = board;
+  out.sha256 = sha;
+  out.url = url;
+  out.version = version;
+  out.size = size;
+  if (!is_hex64(out.sha256)) return OtaCommandResult::BAD_PARAMS;
+  return OtaCommandResult::OK;
+}
+
+const char* ota_command_result_text(OtaCommandResult r) {
+  switch (r) {
+    case OtaCommandResult::OK:            return "ok";
+    case OtaCommandResult::NOT_JSON:      return "not JSON";
+    case OtaCommandResult::NOT_OTA:       return "not an OTA_UPDATE command";
+    case OtaCommandResult::BAD_PARAMS:    return "malformed command";
+    case OtaCommandResult::BAD_SIGNATURE: return "bad signature";
+    case OtaCommandResult::DUPLICATE:     return "already received";
+    case OtaCommandResult::EXPIRED:       return "command expired";
+    default:                              return "unknown";
+  }
+}
diff -ruN a/src/commands/otaCommand.h b/src/commands/otaCommand.h
--- a/src/commands/otaCommand.h	1970-01-01 00:00:00.000000000 +0000
+++ b/src/commands/otaCommand.h
@@ -0,0 +1,56 @@
+#ifndef OTACOMMAND_H
+#define OTACOMMAND_H
+
+/* Remote OTA command (proposed for flexEngineV2 EV-38): a flexCloud command in flexCommunicator's
+   compose_command() format, received over MQTT on flexcloud/<connectorID>/<applicationID>/cmd:
+
+     {"id": "<uuid>", "cmd": "OTA_UPDATE", "priority": 2, "expiry": <unix s>, "timestamp": <unix s>,
+      "nonce": "<hex>", "params": {"board": "<FQBN>", "sha256": "<64 hex>", "size": <bytes>,
+      "url": "http(s)://...", "version": "<firmware version>"}, "signature": "<64 hex>"}
+
+   signature = hex HMAC-SHA256(flexCloud_secret_key, id + cmd + priority + expiry + json.dumps(params,
+   sort_keys=True) + timestamp + nonce), as flcpy's compute_signature(). The node rebuilds the json.dumps text from
+   the five known params (keys sorted, ", " and ": " separators), so a command with other params, or with characters
+   json.dumps would escape, does not verify. */
+
+#include <Arduino.h>
+
+#ifndef FLEXNODE_SECRET_KEY_LEN
+#define FLEXNODE_SECRET_KEY_LEN 32      // length of appDescriptor_config.flexCloud_secret_key
+#endif
+
+// FQBN of the board this library is compiled for (compared with the command's params.board)
+#if defined(ARDUINO_PORTENTA_H7_M7)
+#define FLEXNODE_FQBN "arduino:mbed_portenta:envie_m7"
+#elif defined(ARDUINO_OPTA)
+#define FLEXNODE_FQBN "arduino:mbed_opta:opta"
+#elif defined(ARDUINO_GIGA)
+#define FLEXNODE_FQBN "arduino:mbed_giga:giga"
+#elif defined(ARDUINO_NICLA_VISION)
+#define FLEXNODE_FQBN "arduino:mbed_nicla:nicla_vision"
+#else
+#define FLEXNODE_FQBN "unknown"
+#endif
+
+struct OtaCommand {
+  String id;
+  String url;
+  String sha256;     // lower-case hex of the .ota file
+  String version;    // the version the new firmware reports (set_application_version)
+  String board;
+  unsigned long size = 0;
+  unsigned long expiry = 0;
+};
+
+enum class OtaCommandResult { OK, NOT_JSON, NOT_OTA, BAD_PARAMS, BAD_SIGNATURE, DUPLICATE, EXPIRED };
+
+// parse + authenticate; `out` is filled when the result is OK (id also for EXPIRED)
+OtaCommandResult parse_ota_command(const uint8_t* payload, unsigned int length, const uint8_t* key, size_t keylen,
+                                   OtaCommand& out);
+
+const char* ota_command_result_text(OtaCommandResult r);
+
+// lower-case hex SHA-256 of a file (e.g. the downloaded /fs/UPDATE.BIN.LZSS); false when it cannot be read
+bool sha256_file_hex(const char* path, char out[65]);
+
+#endif // OTACOMMAND_H
