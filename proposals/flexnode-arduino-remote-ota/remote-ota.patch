+/*------------------------- REMOTE OTA (flexEngineV2 arduino-ota driver) ----------------------------*/
 
+const char* FlexNode::command_topic() {
+  static char buffer[128];
+  snprintf(buffer, sizeof(buffer), "flexcloud/%s/%s/cmd", appDescriptor_config.connectorID, appDescriptor_config.id);
+  return buffer;
