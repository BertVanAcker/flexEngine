+void FlexNode::handle_command(const uint8_t* payload, unsigned int length) {
+  OtaCommand cmd;
+  OtaCommandResult r = parse_ota_command(payload, length, appDescriptor_config.flexCloud_secret_key,
+                                         FLEXNODE_SECRET_KEY_LEN, cmd);
+  if (r != OtaCommandResult::OK && r != OtaCommandResult::EXPIRED) {
+    // not authenticated (or not for us): logged, no state written
+    logger.warning((String("OTA_UPDATE rejected: ") + ota_command_result_text(r)).c_str());
+    return;
+  }
+  String why;
+  if (r == OtaCommandResult::EXPIRED) {
+    why = "command expired";
+  } else if (!ota_config.OTA_enabled) {
+    why = "OTA disabled in ota_config";
+  } else if (cmd.board != FLEXNODE_FQBN) {
+    why = String("image is for ") + cmd.board + ", this node is " + FLEXNODE_FQBN;
+  } else if (state != AppState::RUN) {
+    why = "an update is already in progress";
+  }
+  ota_ref_ = cmd.id;
+  ota_target_ = cmd.version;
+  if (why.length()) {
+    report_ota("rejected", why.c_str());
+    logger.warning((String("OTA_UPDATE rejected: ") + why).c_str());
+    return;
+  }
+  report_ota("accepted", "");
+  logger.info((String("OTA_UPDATE accepted: ") + cmd.version).c_str());
+  set_application_status(ApplicationStatus::OTA_IN_PROGRESS);
+  ota_manager.set_ota_url(cmd.url);
+  ota_manager.expect(cmd.sha256, cmd.size);
+  trigger_ota();      // spin(): disconnect MQTT, download, verify, install, restart
+}
 
