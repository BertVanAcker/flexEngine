import time
from pathlib import Path

from flexEngine.supervisor.supervisor import supervisor

# Presence of this file signals a graceful shutdown request from
# `flexEngine stop` (works identically on Windows/macOS/Linux, unlike
# relying on OS signals).
STOP_FILE = Path("agent.stop")

if __name__ == '__main__':
    STOP_FILE.unlink(missing_ok=True)
    agent = supervisor(config="configuration/config.yaml", verbose=False)
    agent.start()
    try:
        while not STOP_FILE.exists():
            time.sleep(1)
    except KeyboardInterrupt:
        pass
    finally:
        agent.stop()
        STOP_FILE.unlink(missing_ok=True)
