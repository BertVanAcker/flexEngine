logging:
  level: "{{log_level}}"
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  file: "logs/syslog_local.log"
  remote: {{log_remote}}

flexCloud:
  storage_type: "global"
  redis_host: "{{redis_host}}"
  redis_port: {{redis_port}}
  redis_db: {{redis_db}}

deviceCredentials:
  name: "{{device_name}}"
  primaryHardwareID: "{{primary_hardware_id}}"     #ID used to link application to device e.g. in AADL
  projectID: "{{project_id}}"                      #Project allocation, based on flexCloud
  key: "{{device_key}}"                            #Unique key generated by flexCloud
  shared_secret: {{shared_secret}}                 #Unique shared key to verify commands and messages

heartbeat:
  heartbeat_interval: {{heartbeat_interval}}       #Heartbeat renewal every x seconds
  ttl: {{heartbeat_ttl}}                           #Heartbeat time-to-live in x seconds
