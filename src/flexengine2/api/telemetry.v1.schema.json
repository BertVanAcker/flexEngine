{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flex.dev/schemas/telemetry.v1.schema.json",
  "title": "CP-8 Telemetry v1",
  "description": "Machine-readable part of CP-8: what the engine emits for observability. LogRecord = one line of the structured engine log (logFormat json), ActionRecord = one line of dataDir/actions.jsonl, SpanRecord = one line of the JSONL span file (FLEX_OTEL_FILE; the same names and attributes go to OTLP), Metrics = Engine.metrics() (GET /v1/metrics per device; UM-4: resources, deploymentResources), WorkloadLogRecord = a workload line of GET /v1/logs (source workload). Prose: api/telemetry.v1.md. tests/api/test_telemetry_contract.py validates what an engine run emits and checks that every span name, log event and action the sources can emit is registered here. Additive only within v1: a new span, attribute, log event, action or metric key.",
  "$defs": {
    "LogLevel": {"enum": ["debug", "info", "warning", "error"]},
    "LogEvent": {
      "description": "Event names of engine log records. action.<ActionKind> and build.<phase> are listed by pattern in LogRecord.event; stdlib records of the flexengine2 package carry their logger name.",
      "enum": [
        "log", "local-api", "onboarded", "offline", "capabilities.sent",
        "manifest.accepted", "manifest.refused", "manifest.unsupported", "state.refused",
        "prepare.deferred", "supervision", "supervise.deferred", "bundle.imported",
        "apply.failed", "stage.failed", "start.failed", "stop.failed", "commit.failed", "repair.failed",
        "rollback.failed", "rollback.resumed", "journal.abandoned", "journal.dropped",
        "outbox.backpressure", "outbox.backpressure-end",
        "engine.start", "engine.stop", "engine.stop-timeout", "engine.error", "engine.crashed", "engine.save-failed",
        "host.on-ready-failed", "observe.failed"
      ]
    },
    "LogRecord": {
      "description": "One structured log line (obs/logging.py, logFormat json, the default). Keys after msg are event-specific (reasonCode, buildId, outboxLength, ...).",
      "type": "object",
      "required": ["ts", "level", "device", "event", "msg"],
      "properties": {
        "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
        "level": {"$ref": "#/$defs/LogLevel"},
        "device": {"type": ["string", "null"]},
        "event": {
          "anyOf": [
            {"$ref": "#/$defs/LogEvent"},
            {"type": "string", "pattern": "^action\\.(apply|adopt|commit|reject|remove|rollback|rollback-resume|repair|retry|stage|start|stop|build)$"},
            {"type": "string", "pattern": "^build\\.(started|progress|log|succeeded|failed)$"},
            {"type": "string", "pattern": "^flexengine2(\\.[A-Za-z0-9_]+)*$"}
          ]
        },
        "dep": {"type": "string"},
        "version": {"type": "string"},
        "msg": {"type": "string"}
      }
    },
    "ActionKind": {"enum": ["apply", "adopt", "commit", "reject", "remove", "rollback", "rollback-resume", "repair", "retry", "stage", "start", "stop", "build"]},
    "ActionRecord": {
      "description": "One line of dataDir/actions.jsonl (fsync per line; read by the SIL scenario and the EV-13 oracles).",
      "type": "object",
      "required": ["t", "action", "dep"],
      "properties": {
        "t": {"type": "number", "description": "unix seconds"},
        "action": {"$ref": "#/$defs/ActionKind"},
        "dep": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "digest": {"type": ["string", "null"]},
        "reason": {"type": "string", "description": "reject"},
        "failed": {"type": "string", "description": "rollback: the failed version"},
        "why": {"type": "string", "description": "remove after a failed first install"},
        "build": {"type": "string", "description": "build: the build id"}
      }
    },
    "SpanName": {
      "description": "Engine span names (one trace per plan). engine.install <dep> and engine.start <dep> carry the deployment id in the name.",
      "anyOf": [
        {"enum": ["engine.health-gate", "engine.rollback", "engine.build", "driver.apply", "driver.remove", "driver.stage", "driver.start", "driver.stop"]},
        {"type": "string", "pattern": "^engine\\.(install|start) [A-Za-z0-9_.-]+$"},
        {"enum": ["flex.plan", "device.status"], "description": "backend-side spans of the same trace (not the engine's)"}
      ]
    },
    "SpanAttributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flex.device": {"type": "string"},
        "flex.deployment": {"type": ["string", "null"]},
        "flex.version": {"type": "string"},
        "flex.driver": {"type": "string", "description": "the driver profile key"},
        "flex.profile": {"type": "string"},
        "flex.manifest_version": {"type": "integer"},
        "flex.seconds": {"type": "number"},
        "flex.healthy": {"type": "boolean"},
        "flex.gate_failure": {"type": "string", "description": "empty when healthy"},
        "flex.rollback": {"type": "boolean"},
        "flex.failed_version": {"type": "string"},
        "flex.build": {"type": "string"},
        "flex.plan_hash": {"type": "string"},
        "flex.correlation_id": {"type": "string"}
      }
    },
    "SpanRecord": {
      "description": "One finished span in the JSONL span file (FLEX_OTEL_FILE).",
      "type": "object",
      "required": ["service", "name", "traceId", "spanId", "parentSpanId", "start", "end", "kind", "status", "attributes", "links"],
      "additionalProperties": false,
      "properties": {
        "service": {"type": "string", "pattern": "^flex-"},
        "name": {"$ref": "#/$defs/SpanName"},
        "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "spanId": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "parentSpanId": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"},
        "start": {"type": "number"},
        "end": {"type": "number"},
        "kind": {"enum": ["INTERNAL", "CLIENT", "SERVER", "PRODUCER", "CONSUMER"]},
        "status": {"enum": ["UNSET", "OK", "ERROR"]},
        "attributes": {"$ref": "#/$defs/SpanAttributes"},
        "links": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}
      }
    },
    "DurationSummary": {
      "type": "object",
      "required": ["last", "max", "avg", "count"],
      "additionalProperties": false,
      "properties": {
        "last": {"type": ["number", "null"]},
        "max": {"type": "number"},
        "avg": {"type": ["number", "null"]},
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "Metrics": {
      "description": "Engine.metrics() of one device engine (GET /v1/metrics answers {deviceId: Metrics}).",
      "type": "object",
      "required": ["device", "role", "ticks", "startedAt", "lastTickAt", "reconcileSeconds", "tickSeconds", "gateSeconds",
                   "outboxLength", "outboxMax", "outboxDropped", "backpressure", "errors", "errorsByType", "lastError",
                   "manifestVersion", "applied"],
      "additionalProperties": false,
      "properties": {
        "device": {"type": "string"},
        "role": {"type": ["string", "null"]},
        "ticks": {"type": "integer", "minimum": 0},
        "startedAt": {"type": "number"},
        "lastTickAt": {"type": ["number", "null"]},
        "reconcileSeconds": {"$ref": "#/$defs/DurationSummary"},
        "tickSeconds": {"$ref": "#/$defs/DurationSummary"},
        "gateSeconds": {"$ref": "#/$defs/DurationSummary"},
        "outboxLength": {"type": "integer", "minimum": 0},
        "outboxMax": {"type": ["integer", "null"]},
        "outboxDropped": {"type": "integer", "minimum": 0},
        "backpressure": {"type": "boolean"},
        "errors": {"type": "object", "additionalProperties": {"type": "integer"}},
        "errorsByType": {"type": "object", "additionalProperties": {"type": "integer"}},
        "lastError": {
          "type": ["object", "null"],
          "properties": {
            "t": {"type": "number"}, "phase": {"type": "string"}, "dep": {"type": ["string", "null"]},
            "type": {"type": "string"}, "message": {"type": "string"}, "where": {"type": ["string", "null"]}
          }
        },
        "manifestVersion": {"type": ["integer", "null"]},
        "applied": {"type": "array", "items": {"type": "string"}},
        "resources": {"$ref": "#/$defs/DeviceResources"},
        "deploymentResources": {
          "type": "object",
          "description": "UM-4: per deployment id, the last sample of the drivers that can measure their workloads (docker, podman, compose, process, systemd); deployments of other drivers are absent",
          "additionalProperties": {"$ref": "#/$defs/DeploymentResourcesSample"}
        }
      }
    },
    "DeviceResources": {
      "description": "UM-4: the host's resources as the engine sees them (obs/resources.py; absent on a child device). Every part optional: what the platform does not tell is left out.",
      "type": "object",
      "required": ["sampledAt"],
      "additionalProperties": false,
      "properties": {
        "sampledAt": {"type": "number", "description": "unix seconds"},
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {"type": "integer", "minimum": 1},
            "load1": {"type": "number", "minimum": 0},
            "load5": {"type": "number", "minimum": 0},
            "load15": {"type": "number", "minimum": 0},
            "percent": {"type": "number", "minimum": 0, "maximum": 100, "description": "busy share of all CPUs since the previous sample (the first: since the engine started)"}
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "totalBytes": {"type": "integer", "minimum": 0},
            "usedBytes": {"type": "integer", "minimum": 0, "description": "total minus MemAvailable"},
            "availableBytes": {"type": "integer", "minimum": 0},
            "percent": {"type": "number", "minimum": 0, "maximum": 100}
          }
        },
        "storage": {
          "type": "object",
          "description": "the file system of the engine's data directory (the device's dataDir)",
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string"},
            "totalBytes": {"type": "integer", "minimum": 0},
            "usedBytes": {"type": "integer", "minimum": 0},
            "freeBytes": {"type": "integer", "minimum": 0, "description": "available to the engine's user"},
            "percent": {"type": "number", "minimum": 0, "maximum": 100, "description": "df's Use%: used of used + free"}
          }
        },
        "temperatureCelsius": {"type": "number", "description": "the hottest CPU / SoC thermal zone, else the first zone"}
      }
    },
    "DeploymentResourcesSample": {
      "description": "UM-4: driver-spi DeploymentResources of one deployment, with when it was sampled and by which driver.",
      "type": "object",
      "required": ["sampledAt", "driver"],
      "additionalProperties": false,
      "properties": {
        "sampledAt": {"type": "number"},
        "driver": {"type": "string"},
        "cpuPercent": {"type": "number", "minimum": 0, "description": "100 = one CPU fully busy"},
        "memoryBytes": {"type": "integer", "minimum": 0},
        "memoryLimitBytes": {"type": "integer", "minimum": 0},
        "memoryPercent": {"type": "number", "minimum": 0},
        "pids": {"type": "integer", "minimum": 0}
      }
    },
    "WorkloadLogRecord": {
      "description": "UM-4: one line a workload wrote, as GET /v1/logs serves it (source workload; stored in dataDir/workload.jsonl by the observer).",
      "type": "object",
      "required": ["t", "ts", "device", "source", "dep", "deployment", "level", "event", "msg"],
      "properties": {
        "t": {"type": "number", "description": "unix seconds the executor recorded, else when the engine collected it"},
        "ts": {"type": "string"},
        "device": {"type": "string"},
        "source": {"const": "workload"},
        "dep": {"type": "string"},
        "deployment": {"type": "string"},
        "stream": {"enum": ["stdout", "stderr"]},
        "container": {"type": "string"},
        "level": {"const": "info"},
        "event": {"const": "workload"},
        "msg": {"type": "string", "maxLength": 4096},
        "truncated": {"const": true}
      }
    }
  }
}
